{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug NGINX (macOS LLDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/objs/nginx",
      "args": [
        "-p",
        "${workspaceFolder}",
        "-c",
        "${workspaceFolder}/conf/nginx.conf"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "Build NGINX"
    },
    {
      "name": "Debug NGINX (Linux GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/objs/nginx",
      "args": [
        "-p",
        "${workspaceFolder}",
        "-c",
        "${workspaceFolder}/conf/nginx.conf"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Follow child on fork",
          "text": "set follow-fork-mode child",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build NGINX"
    }
  ]
}
